<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= signup ? 'Sign up' : 'Log in' %> - Study Space Finder</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <main class="mx-auto max-w-xl px-4 py-8">
      <a href="/spaces" class="text-teal-700">Study spaces</a>
      <%- include('partials/auth-status') %>
      <h1 class="text-3xl font-bold"><%= signup ? 'Sign up' : 'Log in' %></h1>
      <form id="auth-form" action="/auth/<%= signup ? 'signup' : 'login' %>" method="post" class="mt-6 space-y-5">
        <% if (signup) { %>
          <div>
            <label for="name" class="mb-1.5 block text-sm font-medium">Name</label>
            <input id="name" name="name" autocomplete="name" maxlength="100" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5">
          </div>
        <% } %>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium">Email</label>
          <input id="email" name="email" type="email" autocomplete="username" maxlength="254" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5">
        </div>
        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium">Password</label>
          <input id="password" name="password" type="password" autocomplete="<%= signup ? 'new-password' : 'current-password' %>" aria-describedby="password-help" required class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5">
          <p id="password-help" class="mt-3 text-sm text-slate-600"><%= signup ? 'Use at least 12 characters and no more than 72 UTF-8 bytes. Some characters use more than one byte.' : 'Enter your account password.' %></p>
        </div>
        <button type="submit" class="w-full rounded-lg bg-teal-700 px-4 py-3 text-sm font-semibold text-white hover:bg-teal-800"><%= signup ? 'Create account' : 'Log in' %></button>
      </form>
      <p class="mt-3"><%= signup ? 'Already have an account?' : 'Need an account?' %> <a href="/auth/<%= signup ? 'login' : 'signup' %>" class="text-teal-700"><%= signup ? 'Log in' : 'Sign up' %></a></p>
      <noscript>Enable JavaScript to sign up, log in, and log out.</noscript>
    </main>
  </body>
</html>
